<%- include('partials/admin-header', { title: 'Edit Course', page: 'courses' }) %>

<main class="main-content">
    <header class="main-header">
        <h1>Edit Course</h1>
    </header>
    <section class="content-area">
        <div class="content-block">
            <form id="editCourseForm">
    <div class="input-group">
        <label for="courseTitle">Course Title</label>
        <input type="text" id="courseTitle" name="courseTitle" required>
    </div>
    
    <div class="input-group">
        <label for="courseDescription">Description</label>
        <textarea id="courseDescription" name="courseDescription" rows="4" required></textarea>
    </div>

    <div class="input-group">
        <label for="courseOriginalPrice">Original Price / MRP (INR, optional)</label>
        <input type="number" id="courseOriginalPrice" name="courseOriginalPrice" min="0" step="0.01">
    </div>
    <div class="input-group">
        <label for="coursePrice">Selling Price (INR)</label>
        <input type="number" id="coursePrice" name="coursePrice" min="0" step="0.01" required>
        <small>Amount students pay. Enter 0 for a free course.</small>
    </div>

    <div class="input-group">
        <label for="courseDeliveryType">Course Format</label>
        <select id="courseDeliveryType" name="courseDeliveryType">
            <option value="video">Video Course</option>
            <option value="tests">Test Series</option>
            <option value="mixed">Video + Tests</option>
        </select>
    </div>
    <div class="input-group">
        <label>Video Lessons</label>
        <div id="lessonBuilder" style="display:grid;gap:12px;"></div>
        <button type="button" id="addLessonBtn" class="btn btn-secondary" style="width:max-content;margin-top:10px;"><i class="fas fa-plus"></i> Add lesson</button>
        <textarea id="courseCurriculum" name="courseCurriculum" rows="5" placeholder='Advanced JSON option'></textarea>
        <small style="color:#666;">Use a cloud video ID/key, not a public secret URL. The lesson cards generate the saved curriculum.</small>
    </div>

    <div class="input-group-checkbox">
        <input type="checkbox" id="isPublished" name="isPublished">
        <label for="isPublished">Published</label>
    </div>
    
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a href="/admin/courses" class="btn btn-secondary" style="width: auto;">Cancel</a>
</form>
        </div>
    </section>
</main>

<%- include('partials/admin-footer', { script: null }) %>
