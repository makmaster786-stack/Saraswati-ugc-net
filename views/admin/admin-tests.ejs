<%- include('partials/admin-header', { title: 'Manage Tests', page: 'tests' }) %>

<main class="main-content">
    <header class="main-header">
        <h1>Manage Tests</h1>
        <small style="color:#64748b;">Test manager v3 · Single-submit protection</small>
    </header>
    <section class="content-area">
        <div class="content-grid">
            
            <div class="form-container content-block">
                <h2><i class="fas fa-plus-circle"></i> Create New Test</h2>
                <form id="createSingleTest">
                    <div class="input-group">
                        <label for="testTitle">Test Title *</label>
                        <input type="text" id="testTitle" name="testTitle" placeholder="e.g., Teaching Aptitude Mock Test 1" required>
                    </div>
                    
                    <div class="input-group">
                        <label for="testCourse">Assign to Course *</label>
                        <select id="testCourse" name="testCourse" required>
                            <option value="">-- Loading Courses... --</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="seriesTitle">Test Series Name (Optional)</label>
                        <input type="text" id="seriesTitle" placeholder="e.g., Paper 1 Complete Test Series">
                        <small style="color:#666;">Use the same name for every test in one series.</small>
                    </div>

                    <div class="input-group" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div>
                            <label for="unitName">Unit</label>
                            <input type="text" id="unitName" value="General" placeholder="e.g., Teaching Aptitude">
                        </div>
                        <div>
                            <label for="unitOrder">Unit Number</label>
                            <input type="number" id="unitOrder" value="1" min="1">
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="testOrder">Test Number in Unit</label>
                        <input type="number" id="testOrder" value="1" min="1">
                    </div>

                    <div class="input-group">
                        <label for="testDuration">Duration (in minutes) *</label>
                        <input type="number" id="testDuration" name="testDuration" value="60" required>
                    </div>

                    <div class="input-group">
                        <label for="unlockDate">Unlock Date (Optional)</label>
                        <input type="date" id="unlockDate" name="unlockDate">
                        <small style="color: #666;">Leave empty to unlock immediately.</small>
                    </div>

                    <div class="input-group-checkbox">
                        <input type="checkbox" id="isFreeTest" name="isFreeTest">
                        <label for="isFreeTest">Make this test free (Demo)</label>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Create Test
                    </button>
                </form>

                <hr style="margin:24px 0;border:0;border-top:1px solid #e2e8f0;">
                <h2><i class="fas fa-layer-group"></i> Create Unit Test Set</h2>
                <p style="font-size:.82rem;color:#64748b;">Create up to 50 tests in one unit. Add questions later.</p>
                <form id="bulkTestForm">
                    <input id="bulkSeriesTitle" placeholder="Series name" required>
                    <input id="bulkUnitName" placeholder="Unit name" required>
                    <input id="bulkUnitOrder" type="number" min="1" value="1" placeholder="Unit number" required>
                    <textarea id="bulkTestTitles" rows="5" placeholder="One test title per line" required></textarea>
                    <button type="submit" class="btn btn-secondary">Create Unit Tests</button>
                </form>
            </div>

            <div class="list-container content-block">
                <div class="admin-toolbar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <h2><i class="fas fa-list"></i> Existing Tests</h2>
                    <input type="text" id="testSearch" placeholder="Search tests..." 
                           style="padding:8px; border:1px solid #ddd; border-radius:4px; width:200px;">
                </div>

                <div class="test-filters">
                    <label>Course<select id="filterCourse"><option value="">All courses</option></select></label>
                    <label>Unit<select id="filterUnit"><option value="">All units</option><% for (let n = 1; n <= 11; n++) { %><option value="<%= n %>">Unit <%= n %></option><% } %></select></label>
                    <label>Questions<select id="filterQuestions"><option value="">All tests</option><option value="empty">Needs questions</option><option value="filled">Questions added</option></select></label>
                </div>
                <p id="testResultSummary" aria-live="polite"></p>
                <div class="table-responsive">
                    <table id="testsTable" class="admin-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Course</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="testsTableBody">
                            <tr><td colspan="4" style="text-align:center; padding:20px;">Loading tests...</td></tr>
                        </tbody>
                    </table>
                </div>

                <div id="testPagination" class="pagination-controls" 
                     style="margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
                </div>
            </div>

        </div>
    </section>
</main>

<style>
    .content-grid { grid-template-columns: minmax(300px, 1fr) minmax(0, 2fr); }
    .list-container { min-width: 0; }
    .test-filters { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
    .test-filters label { flex: 1; min-width: 140px; font-size: .85rem; }
    .test-filters select, #bulkTestForm input, #bulkTestForm textarea { display: block; width: 100%; box-sizing: border-box; padding: 10px; margin-top: 6px; border: 1px solid #cbd5e1; border-radius: 8px; }
    #bulkTestForm input, #bulkTestForm textarea { margin-bottom: 12px; }
    #testsTable { table-layout: fixed; width: 100%; }
    #testsTable th:first-child { width: 40%; }
    #testsTable td { overflow-wrap: anywhere; }
    .test-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .test-actions a { font-size: .8rem; }
    @media (max-width: 1100px) { .content-grid { grid-template-columns: 1fr; } }
    @media (max-width: 600px) { #testsTable th:nth-child(2), #testsTable td:nth-child(2) { display: none; } .admin-toolbar { flex-wrap: wrap; gap: 10px; } }
</style>

<script>
    function escapeTestText(value) {
        return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    document.addEventListener('DOMContentLoaded', () => {
        loadTests(1);
        populateCourseDropdown(); // Helper to fill the "Assign to Course" dropdown
        ['filterCourse', 'filterUnit', 'filterQuestions'].forEach(id => document.getElementById(id).addEventListener('change', () => loadTests(1)));

        // Search Handler
        let debounceTimer;
        document.getElementById('testSearch')?.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => loadTests(1), 500);
        });
        
        // Add Test Form Handler
        document.getElementById('createSingleTest')?.addEventListener('submit', handleCreateTest);
        document.getElementById('bulkTestForm')?.addEventListener('submit', handleBulkTests);
    });

    // 1. Fetch Tests
    async function loadTests(page) {
        const search = document.getElementById('testSearch').value;
        const tbody = document.getElementById('testsTableBody');
        
        try {
            const params = new URLSearchParams({page, limit: 20, search, courseId: document.getElementById('filterCourse').value, unitOrder: document.getElementById('filterUnit').value, questionStatus: document.getElementById('filterQuestions').value});
            const res = await fetch(`/api/admin/tests?${params}`);
            const data = await res.json();

            if (data.success) {
                renderTestsTable(data.tests);
                document.getElementById('testResultSummary').textContent = `${data.pagination.totalItems} matching tests · ordered by unit and test number`;
                renderPagination(data.pagination, 'testPagination', loadTests);
            } else throw new Error(data.message || 'Failed to load tests');
        } catch (error) {
            console.error(error);
            tbody.innerHTML = `<tr><td colspan="4" style="color:red; text-align:center;">Error loading tests</td></tr>`;
        }
    }

    async function handleBulkTests(e) {
        e.preventDefault();
        e.stopPropagation();
        const form = e.target;
        if (form.dataset.submitting === 'true') return;
        const titles = document.getElementById('bulkTestTitles').value.split(/\r?\n/).map(title => title.trim()).filter(Boolean);
        const courseId = document.getElementById('testCourse').value;
        if (!courseId) return alert('Select a course first.');
        if (!titles.length || titles.length > 50) return alert('Enter between 1 and 50 test titles.');
        form.dataset.submitting = 'true';
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        try {
        const response = await fetch('/api/admin/tests/bulk', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ courseId, seriesTitle:document.getElementById('bulkSeriesTitle').value, unitName:document.getElementById('bulkUnitName').value, unitOrder:document.getElementById('bulkUnitOrder').value, tests:titles.map(title => ({ title })) }) });
        const data = await response.json();
        if (!response.ok) return alert(data.message || 'Bulk creation failed');
        alert(`${data.count} tests created successfully.`); e.target.reset(); loadTests(1);
        } catch (error) {
            console.error(error);
            alert('Could not confirm creation. Refresh the test list before trying again.');
        } finally {
            delete form.dataset.submitting;
            button.disabled = false;
        }
    }

    // 2. Render Table
    function renderTestsTable(tests) {
        const tbody = document.getElementById('testsTableBody');
        if (tests.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;">No tests found.</td></tr>`;
            return;
        }

        tbody.innerHTML = tests.map(test => `
            <tr>
                <td>
                    <strong>${escapeTestText(test.title)}</strong>
                    ${test.isFree ? '<span class="badge success" style="font-size:0.7em; margin-left:5px;">FREE</span>' : ''}
                    <small style="display:block;color:#64748b;">Unit ${escapeTestText(test.unitOrder || 1)}: ${escapeTestText(test.unitName || 'General')} · Test ${escapeTestText(test.testOrder || 1)}</small>
                </td>
                <td>${escapeTestText(test.course?.title || 'General')}</td>
                <td>
                    <span class="badge ${test.questions?.length > 0 ? 'success' : 'warning'}">
                        ${test.questions?.length || 0} questions
                    </span>
                </td>
                <td>
                    <div class="test-actions"><a href="/admin/test-details?id=${encodeURIComponent(test._id)}" class="btn btn-primary">Questions / Excel</a>
                    <a href="/admin/edit-test?id=${encodeURIComponent(test._id)}" class="btn-icon" title="Edit test settings">Edit</a>
                    <button onclick="deleteTest('${test._id}')" class="btn-icon delete" title="Delete"><i class="fas fa-trash"></i></button>
                    </div>
                </td>
            </tr>
        `).join('');
    }

    // 3. Render Pagination Buttons
    function renderPagination(meta, containerId, fetchFunction) {
        const container = document.getElementById(containerId);
        if (!container) return;

        if (meta.totalPages <= 1) {
            container.innerHTML = '';
            return;
        }

        container.innerHTML = `
            <button class="btn btn-sm btn-outline" ${!meta.hasPrev ? 'disabled' : ''} onclick="${fetchFunction.name}(${meta.currentPage - 1})">
                <i class="fas fa-chevron-left"></i> Prev
            </button>
            <span style="padding: 5px 10px; font-weight:600; color:#555;">
                Page ${meta.currentPage} of ${meta.totalPages}
            </span>
            <button class="btn btn-sm btn-outline" ${!meta.hasNext ? 'disabled' : ''} onclick="${fetchFunction.name}(${meta.currentPage + 1})">
                Next <i class="fas fa-chevron-right"></i>
            </button>
        `;
    }

    // Helper: Fill the course dropdown for the form
    async function populateCourseDropdown() {
        try {
            const res = await fetch('/api/admin/courses?limit=100'); // Get enough courses for dropdown
            const data = await res.json();
            const select = document.getElementById('testCourse');
            
            if (data.success && select) {
                select.innerHTML = '<option value="">-- Select Course --</option>' + 
                    data.courses.map(c => `<option value="${escapeTestText(c._id)}">${escapeTestText(c.title)}</option>`).join('');
                document.getElementById('filterCourse').innerHTML = '<option value="">All courses</option>' + data.courses.map(c => `<option value="${escapeTestText(c._id)}">${escapeTestText(c.title)}</option>`).join('');
            }
        } catch (e) { console.error('Failed to load courses for dropdown'); }
    }

    // Helper: Delete Test
    async function deleteTest(id) {
        if(!confirm('Are you sure? This will delete the test and its associated questions.')) return;
        try {
            await fetch(`/api/admin/tests/${id}`, { method: 'DELETE' });
            loadTests(1);
        } catch(e) { alert('Delete failed'); }
    }

    // Helper: Create Test (Simple version)
    async function handleCreateTest(e) {
        e.preventDefault();
        e.stopPropagation();
        const form = e.target;
        if (form.dataset.submitting === 'true') return;
        form.dataset.submitting = 'true';
        const button = form.querySelector('button[type="submit"]');
        const originalText = button.innerHTML;
        button.disabled = true;
        button.textContent = 'Creating test...';
        const formData = {
            title: document.getElementById('testTitle').value,
            courseId: document.getElementById('testCourse').value,
            duration: document.getElementById('testDuration').value,
            unlockDate: document.getElementById('unlockDate').value || null,
            isFree: document.getElementById('isFreeTest').checked,
            seriesTitle: document.getElementById('seriesTitle').value.trim(),
            unitName: document.getElementById('unitName').value.trim() || 'General',
            unitOrder: document.getElementById('unitOrder').value,
            testOrder: document.getElementById('testOrder').value
        };

        try {
            const res = await fetch('/api/admin/tests', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(formData)
            });
            if(res.ok) {
                alert('Test Created Successfully!');
                loadTests(1);
                e.target.reset();
            } else {
                alert('Failed to create test');
            }
        } catch(err) {
            console.error(err);
            alert('Could not confirm test creation. Refresh the test list before trying again.');
        } finally {
            delete form.dataset.submitting;
            button.disabled = false;
            button.innerHTML = originalText;
        }
    }
</script>

<%- include('partials/admin-footer', { script: null }) %>
